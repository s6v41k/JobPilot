# Copy this file to .env and fill in your own values.

# --- Adzuna (https://developer.adzuna.com) ---
# Free keys are limited (we have ~25 calls/month), so Adzuna is a last-resort source.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_MONTHLY_BUDGET=25

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3
NUM_CTX=8192
REQUEST_TIMEOUT=120

# --- Scraping (polite rate limit, seconds between requests to the same site) ---
SCRAPE_DELAY_SECONDS=2.5

# --- Storage ---
DB_PATH=data/jobpilot.db
LOG_DIR=logs
